{
  "version": "1.0",
  "description": "PDF図面向けスタンプカタログ。size_mm は用紙上の実寸（mm）、color は #RRGGBB または [r,g,b]（0.0-1.0 / 0-255）。",
  "defaults": {
    "line_width": 1.2,
    "font_size_pt": 9.0,
    "label_gap_mm": 1.5
  },
  "stamps": [
    {
      "id": "STAMP_X",
      "label": "✖（削除）",
      "shape": "cross",
      "color": "#E02020",
      "size_mm": [8.0, 8.0],
      "line_width": 1.6,
      "default_text": "削除",
      "show_label": true
    },
    {
      "id": "STAMP_RECT",
      "label": "赤枠（要確認）",
      "shape": "rect",
      "color": "#E02020",
      "size_mm": [24.0, 12.0],
      "line_width": 1.2,
      "default_text": "要確認",
      "show_label": true
    },
    {
      "id": "STAMP_CIRCLE",
      "label": "丸囲み（注目）",
      "shape": "circle",
      "color": "#F08000",
      "size_mm": [16.0, 16.0],
      "line_width": 1.2,
      "default_text": "",
      "show_label": true
    },
    {
      "id": "STAMP_ARROW",
      "label": "矢印（指示）",
      "shape": "arrow",
      "color": "#1060C0",
      "size_mm": [18.0, 18.0],
      "line_width": 1.4,
      "angle_deg": 225.0,
      "default_text": "",
      "show_label": true
    },
    {
      "id": "STAMP_CHECK",
      "label": "要確認（文字）",
      "shape": "text",
      "color": "#1060C0",
      "size_mm": [22.0, 7.0],
      "line_width": 0.8,
      "font_size_pt": 10.0,
      "default_text": "要確認",
      "show_label": true
    },
    {
      "id": "STAMP_CLOUD",
      "label": "変更雲（範囲）",
      "shape": "cloud",
      "color": "#C000C0",
      "size_mm": [30.0, 18.0],
      "line_width": 1.0,
      "default_text": "変更",
      "show_label": true
    }
  ]
}
